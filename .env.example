POSTGRES_USER=retail_data
POSTGRES_PASSWORD=replace_for_local_development
POSTGRES_DB=retail_data
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://retail_data:replace_for_local_development@127.0.0.1:5432/retail_data

# Read API: dedicated SELECT-only credentials; never reuse the importer login.
# API_DATABASE_URL=postgresql+psycopg://api_reader:replace_locally@127.0.0.1:5432/retail_data
# API_ISSUER=https://identity.example.test/realms/retail
# API_AUDIENCE=retail-api
# API_JWKS_URL=https://identity.example.test/realms/retail/protocol/openid-connect/certs
# API_HOSTS=localhost,127.0.0.1
# API_ORIGINS=http://localhost:3000
# API_SCHEMA=public

# Personal browser login: public OIDC client, no client secret and no refresh token.
# API_CLIENT_ID=retail-personal
# AUTH_AUTHORIZATION_URL=https://identity.example.test/realms/retail/protocol/openid-connect/auth
# AUTH_TOKEN_URL=https://identity.example.test/realms/retail/protocol/openid-connect/token
# AUTH_API_URL=http://127.0.0.1:8000
# AUTH_CALLBACK_PORT=8765
